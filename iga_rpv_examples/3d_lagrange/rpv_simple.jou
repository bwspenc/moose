reset
graphics axis on

#{outer_radius=2.416302}
#{clad_inner_radius=2.197100}
#{base_inner_radius=2.201164}
#{bottom_z = -0.6}
# Note that the position of the thickness transition is 4.378908 in the
# full model. Making it higher to cover the inlets too.
#{top_z = 6.4}
#{core_height = top_z - bottom_z}

create cylinder height {core_height} radius {clad_inner_radius}
create sphere radius {clad_inner_radius}
volume 2 move z {core_height/2}
create sphere radius {clad_inner_radius}
volume 3 move z {-core_height/2}
unite volume 1 2 3

create cylinder height {core_height} radius {base_inner_radius}
create sphere radius {base_inner_radius}
volume 5 move z {core_height/2}
create sphere radius {base_inner_radius}
volume 6 move z {-core_height/2}
unite volume 4 5 6

create cylinder height {core_height} radius {outer_radius}
create sphere radius {outer_radius}
volume 8 move z {core_height/2}
create sphere radius {outer_radius}
volume 9 move z {-core_height/2}
unite volume 7 8 9

subtract volume 1 from volume 4 7
chop volume 11 with volume 10

webcut volume all with general plane xz
delete volume 12 13
webcut volume all with general plane yz
delete volume 16 17

webcut volume all with general plane xy offset {core_height/2}
webcut volume all with general plane xy offset {-core_height/2}

volume all move z {top_z - core_height/2}

merge all
compress ids all
volume all size {core_height/40}
curve 23 32 31 36 35 22 interval 1
mesh volume all

## asign blocks/sidesets

block 1 volume 2 4 6
block 2 volume 1 3 5

# side that is most closely XZ plane
Sideset 1 surface 12 15 18 19 23 24

# side that is most closely YZ plane
Sideset 2 surface 11 14 17 20 22 25

# Inner Liner
sideset 3 surface 1 2 4

# Outer Surfaces
sideset 4 surface 7 8 9

# Bottom node
nodeset 101 vertex 17

block all element type HEX27

export mesh 'rpv_simple.e' overwrite
